# Berkas ini adalah TEMPLATE dan ikut masuk Git.
# Jangan pernah mengisinya dengan nilai asli. Salin ke .env.local
# (yang ter-gitignore) lalu isi di sana.

# Kredensial OAuth dari Google Cloud Console.
# Authorized redirect URI yang perlu didaftarkan di sana:
#   http://localhost:3000/api/auth/callback/google
#   https://koreksiotomasi.vercel.app/api/auth/callback/google
# Client secret diawali GOCSPX- dan berbeda dari Client ID.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Kunci penandatangan cookie sesi. Hasilkan dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan pakai `npx auth secret` - paket itu milik Better Auth, bukan
# next-auth, dan menghasilkan nama variabel yang salah.
AUTH_SECRET=

# Email yang diberi akses admin. Pisahkan dengan koma bila lebih dari satu.
ADMIN_EMAIL=

# Alamat backend FastAPI tujuan rewrite /api/*.
# Biarkan kosong untuk pengembangan lokal (default http://127.0.0.1:9101).
BACKEND_URL=

# Connection string PostgreSQL (Neon). Bentuknya:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
