# Kredensial OAuth dari Google Cloud Console.
# Authorized redirect URI yang perlu didaftarkan di sana:
#   http://localhost:3000/api/auth/callback/google
#   https://koreksiotomasi.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Kunci penandatangan cookie sesi. Hasilkan dengan: npx auth secret
AUTH_SECRET=

# Email yang diberi akses admin. Pisahkan dengan koma bila lebih dari satu.
ADMIN_EMAIL=

# Alamat backend FastAPI tujuan rewrite /api/*.
# Biarkan kosong untuk pengembangan lokal (default http://127.0.0.1:9101).
BACKEND_URL=
